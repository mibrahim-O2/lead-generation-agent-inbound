# =============================================================================
# example.env - copy to ".env" and fill in:   cp example.env .env
#
# NEVER commit .env (it is git-ignored). Every value below is a placeholder.
# This is a demo project: use dummy data only.
# =============================================================================

# --- Model provider ----------------------------------------------------------

# OPENAI_API_KEY - REQUIRED for real runs with the default provider.
#   NOT needed for tests, CI, or mock mode (LEADGEN_MOCK_LLM=1).
#   Where to get it: https://platform.openai.com/api-keys
#   Format: starts with "sk-"
#   If missing: real runs stop at startup with a "missing API key" error.
OPENAI_API_KEY=sk-REPLACE-ME

# LLM_PROVIDER - optional. Which provider the agent talks to. Default: openai
#   Other providers are added in the model-switch task (see MODEL_SWITCH.md).
#   If missing: openai is used.
LLM_PROVIDER=openai

# LLM_MODEL - optional. Model name for the chosen provider, e.g. gpt-4.1-mini
#   If missing/empty: the Agents SDK's own default model is used.
LLM_MODEL=

# Other providers' keys - optional, only the one matching LLM_PROVIDER is read.
#   Exact names and usage are confirmed in MODEL_SWITCH.md (model-switch task).
#   If missing while that provider is selected: startup error naming the key.
# ANTHROPIC_API_KEY=REPLACE-ME      # https://console.anthropic.com/
# GEMINI_API_KEY=REPLACE-ME         # https://aistudio.google.com/apikey
# MISTRAL_API_KEY=REPLACE-ME        # https://console.mistral.ai/
# DEEPSEEK_API_KEY=REPLACE-ME       # https://platform.deepseek.com/
# GROQ_API_KEY=REPLACE-ME           # https://console.groq.com/keys
# OPENROUTER_API_KEY=REPLACE-ME     # https://openrouter.ai/keys
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local Ollama, no key needed

# LEADGEN_MOCK_LLM - optional. 1 = use the built-in fake model (no key, no
#   network, no cost). Used by tests and the offline demo. Default: 0
#   If missing: the real provider is used.
LEADGEN_MOCK_LLM=0

# OPENAI_AGENTS_DISABLE_TRACING - optional. 1 = do not upload run traces to
#   OpenAI. Recommended when using a non-OpenAI provider. Default: 0
#   If missing: tracing stays on (it needs OPENAI_API_KEY to upload).
OPENAI_AGENTS_DISABLE_TRACING=0

# --- Safety limits (all optional; these are the defaults) ---------------------
#   If missing: the default shown is used. A run stops cleanly when a limit hits.

# Max leads handled in one run.
MAX_LEADS_PER_RUN=25
# Max tool calls the agent may make for a single lead.
MAX_TOOL_CALLS_PER_LEAD=12
# Max total tokens (input + output) for one run.
MAX_TOKENS_PER_RUN=200000

# --- Config and storage (all optional) ----------------------------------------

# LEADGEN_PRESET - niche rule book to load from presets/<name>.yaml. Default: solar
#   If missing: solar.
LEADGEN_PRESET=solar

# LEADGEN_CLIENT_CONFIG - client-specific values layered on top of the preset.
#   If missing: config/client.yaml is used; if that file is absent, preset only.
LEADGEN_CLIENT_CONFIG=config/client.yaml

# LEADGEN_DATA_DIR - where real runs write leads, drafts and run logs
#   (git-ignored). If missing: data/runtime
LEADGEN_DATA_DIR=data/runtime

# --- Local API server for the dashboard (all optional) ------------------------

# Host/port the local FastAPI server binds to. Keep 127.0.0.1 (local only).
#   If missing: 127.0.0.1 and 8000.
API_HOST=127.0.0.1
API_PORT=8000

# CORS_ORIGINS - comma-separated origins allowed to call the API (the Vite
#   dev server). If missing: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Dashboard (read by Vite at build time) -----------------------------------
#   WARNING: every VITE_* value is baked into the public JavaScript bundle.
#   Never put a key or secret in a VITE_* variable.

# VITE_API_URL - optional. Where the dashboard finds the local API (LOCAL MODE).
#   If missing: the dashboard runs in DEMO MODE with bundled dummy data.
VITE_API_URL=http://localhost:8000
